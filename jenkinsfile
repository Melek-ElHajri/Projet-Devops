pipeline {
    agent any

    environment {
        dockerhub_token = credentials('dockerhub_token')
        notify_token = credentials('NOTIFY_TOKEN')
    }

    tools {
        jdk 'JAVA_HOME'
        maven 'M2_HOME'
    }

    stages {
        stage('GIT') {
            steps {
                git branch: 'ElHedi-Melek-Elhajri',
                    url: 'https://github.com/Melek-ElHajri/Projet-Devops.git'
            }
        }

        stage('Pre-commit Security Hooks') {
            steps {
                script {
                    def result = sh(script: '''
                        if ! command -v pre-commit &> /dev/null; then
                            echo "pre-commit is not installed, installing in a virtual environment..."
                            python3 -m venv venv
                            . venv/bin/activate
                            pip install pre-commit
                        else
                            echo "pre-commit is already installed."
                        fi
                        git config --unset-all core.hooksPath
                        pre-commit install
                        pre-commit run --all-files
                        deactivate
                    ''', returnStatus: true)

                    if (result != 0) {
                        echo "Pre-commit hooks did not pass, but continuing pipeline."
                    } else {
                        echo "Pre-commit hooks passed successfully."
                    }
                }
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean install compile'
            }
        }

        stage('Scan') {
            steps {
                sh '''
                    if ! docker ps | grep -q 656251e296fb; then
                        echo "SonarQube container is not running. Starting SonarQube container..."
                        docker start 656251e296fb
                        sleep 20
                    else
                        echo "SonarQube container is already running."
                    fi
                '''
                
                withSonarQubeEnv('sq') {
                    sh 'mvn sonar:sonar'
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                sh '''
                    if ! docker ps | grep -q a5b6a466786c; then
                        echo "Nexus container is not running. Starting container..."
                        docker start a5b6a466786c
                        sleep 30
                    else
                        echo "Nexus container is already running."
                    fi
                '''
                
                sh 'mvn deploy -DskipTests -DaltDeploymentRepository=deploymentRepo::default::http://192.168.10.2:8081/repository/maven-releases/'
            }
        }

        stage('Start Monitoring Containers') {
            steps {
                sh 'docker start 4223e0421a91'
                sh 'docker start cf099f77ec8b'
            }
        }

        stage('Security Scan: Nmap') {
            steps {
                script {
                    echo "Starting Nmap Security Scan..."
                    sh 'nmap -sS -p 8089 -v 192.168.10.2'
                }
            }
        }

        stage('ZAP Baseline Scan') {
            steps {
                script {
                    def result = sh(script: '''
                        docker run --rm -v $(pwd):/zap/wrk:rw zaproxy/zap-stable \
                        zap-baseline.py -t http://192.168.10.2:8080 -r zap_report.html
                    ''', returnStatus: true)
                    
                    if (result != 0) {
                        echo "ZAP Baseline Scan failed, but continuing pipeline."
                    } else {
                        echo "ZAP Baseline Scan completed successfully."
                    }
                }
            }
        }

        stage('Publish ZAP Report') {
            steps {
                script {
                    // Check if the report exists
                    def reportFile = 'zap_report.html'
                    if (fileExists(reportFile)) {
                        publishHTML(target: [
                            allowMissing: true,  // Allow the report to be missing without failing the build
                            alwaysLinkToLastBuild: true,
                            keepAll: true,
                            reportDir: '.',
                            reportFiles: reportFile,
                            reportName: 'ZAP Baseline Report'
                        ])
                        echo "ZAP report published successfully."
                    } else {
                        echo "ZAP report not found, skipping publication."
                    }
                }
            }
        }
    }

    /*
    post {
        success {
            script {
                notifyEvents message: "<b>Build Success</b> - Job: ${env.JOB_NAME}, Build Number: ${env.BUILD_NUMBER}", 
                             token: env.notify_token
            }
        }
        
        failure {
            script {
                notifyEvents message: "<b>Build Failed</b> - Job: ${env.JOB_NAME}, Build Number: ${env.BUILD_NUMBER}", 
                             token: env.notify_token
            }
        }
    }
    */
}
